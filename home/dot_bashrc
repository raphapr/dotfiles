# shellcheck shell=bash
# Fallback shell; fish is the daily driver.

# Add ~/.bin to PATH if not already present
case ":$PATH:" in
*":$HOME/.bin:"*) ;;
*) export PATH="$PATH:$HOME/.bin" ;;
esac

export EDITOR=nvim
export BROWSER="$HOME/.bin/browse"

# If not running interactively, don't do anything
[ -z "$PS1" ] && return

GPG_TTY="$(tty)"
export GPG_TTY

shopt -s checkwinsize
PS1="\w » "

# History
HISTCONTROL=ignoredups:ignorespace
HISTSIZE=100000
HISTFILESIZE=100000
shopt -s histappend cmdhist
# After each command, append this shell's history and import only new entries.
export PROMPT_COMMAND="${PROMPT_COMMAND:+$PROMPT_COMMAND$'\n'}history -a && history -n"

# git completion
if [ -f ~/.git-completion.bash ]; then
  # shellcheck source=/dev/null
  source ~/.git-completion.bash
fi

eval "$(mise activate bash)"

# fzf is installed via mise, so this must come after mise activate.
command -v fzf >/dev/null 2>&1 && eval "$(fzf --bash)"

alias ls='ls --color=auto'
alias grep='grep --color=auto'
alias vim='nvim'
alias g='git'
alias tmux='tmux -f ~/.tmux/tmux.conf'
