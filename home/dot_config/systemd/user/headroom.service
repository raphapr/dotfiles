[Unit]
Description=Headroom context-compression proxy for AI agents

[Service]
Type=simple
# Run the mise-managed Headroom CLI. `latest` follows the version selected by mise.
ExecStart=%h/.local/share/mise/installs/pipx-headroom-ai/latest/bin/headroom proxy --port 8787 --code-aware --lossless --memory --learn
Environment=HEADROOM_TELEMETRY=off
Environment=HEADROOM_UPDATE_CHECK=off
# Memory/CCR roots resolve to {cwd}/.headroom; pin cwd so they can't move.
WorkingDirectory=%h
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
