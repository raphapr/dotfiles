#!/bin/bash
# Re-runs whenever a package manifest for this host changes.
# base manifest hash: {{ include "dot_pkglist/base/packages" | sha256sum }}
# common manifest hash: {{ include "dot_pkglist/official/private_common" | sha256sum }}
{{- $hostList := printf "dot_pkglist/official/%s" .chezmoi.hostname }}
{{- if stat (joinPath .chezmoi.sourceDir $hostList) }}
# {{ .chezmoi.hostname }} manifest hash: {{ include $hostList | sha256sum }}
{{- end }}

set -euo pipefail

{{ template "confirm.sh" (printf "Update the system and install official packages for %s?" .chezmoi.hostname) }}

readonly PKGLIST=$HOME/.pkglist
packages=()

queue_packages() {
  local pkg_file="$1"
  local -a file_packages=()

  if [[ ! -f "$pkg_file" ]]; then
    echo "No package list at $pkg_file, skipping."
    return 0
  fi

  mapfile -t file_packages < <(grep -Ev '^[[:space:]]*(#|$)' "$pkg_file")
  packages+=("${file_packages[@]}")
  echo "Queued ${#file_packages[@]} packages from $pkg_file."
}

echo ">> Updating system packages..."
sudo pacman -Syu

queue_packages "$PKGLIST/base/packages"
queue_packages "$PKGLIST/official/common"
queue_packages "$PKGLIST/official/{{ .chezmoi.hostname }}"

if [[ ${#packages[@]} -eq 0 ]]; then
  echo "No official packages listed; nothing to install."
  exit 0
fi

echo ">> Installing ${#packages[@]} official packages in one transaction..."
sudo pacman -S --needed --noconfirm "${packages[@]}"
