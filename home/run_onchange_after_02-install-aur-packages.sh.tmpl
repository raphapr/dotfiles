#!/bin/bash
# Re-runs whenever the AUR package manifest changes.
# package manifest hash: {{ include "dot_pkglist/aur/private_packages" | sha256sum }}

set -euo pipefail

{{ template "confirm.sh" "Install AUR packages?" }}

readonly PKG_AUR=$HOME/.pkglist/aur/packages

if [[ ! -f "$PKG_AUR" ]]; then
  echo "AUR package list not found at $PKG_AUR" >&2
  exit 1
fi

if ! command -v yay >/dev/null 2>&1; then
  echo ">> yay not found; installing it..."
  sudo pacman -S --needed --noconfirm yay
fi

mapfile -t packages < <(grep -Ev '^[[:space:]]*(#|$)' "$PKG_AUR")

if [[ ${#packages[@]} -eq 0 ]]; then
  echo "No AUR packages listed; nothing to install."
  exit 0
fi

echo ">> Installing ${#packages[@]} AUR packages in one transaction..."
yay -S --needed --noconfirm "${packages[@]}"
