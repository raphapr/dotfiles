#!/usr/bin/env bash
url="$1"
host=$(printf '%s' "$url" | sed -E 's#^[a-zA-Z]+://([^/:?]+).*#\1#')

hosts_file="${XDG_CONFIG_HOME:-$HOME/.config}/browse/chrome-hosts"
chrome_hosts=()
[[ -r $hosts_file ]] && mapfile -t chrome_hosts < <(grep -vE '^[[:space:]]*(#|$)' "$hosts_file")

for pat in "${chrome_hosts[@]}"; do
  # shellcheck disable=SC2053  # glob match is intentional
  if [[ $host == $pat ]]; then
    exec google-chrome-stable --profile-directory="Profile 1" "$url"
  fi
done
exec firefox "$url"
