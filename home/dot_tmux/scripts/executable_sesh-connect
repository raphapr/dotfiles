#!/usr/bin/env bash

repo_icon=$(printf '\356\251\242')
repos_root=${REPOS_ROOT:-$HOME/repos}
export REPO_ICON=$repo_icon REPOS_ROOT=$repos_root

choice="$(
  { sesh list -t -c --icons; ghq-list-projects; } | fzf-tmux -p 80%,70% \
    --no-sort --ansi --border-label ' sesh ' --prompt '⚡  ' \
    --header '  ^a all ^t tmux ^g configs ^x/^f ghq ^d tmux kill' \
    --bind 'tab:down,btab:up' \
    --bind 'ctrl-a:change-prompt(⚡  )+reload(sesh list -t -c --icons; ghq-list-projects)' \
    --bind 'ctrl-t:change-prompt(🪟  )+reload(sesh list -t --icons)' \
    --bind 'ctrl-g:change-prompt(⚙️  )+reload(sesh list -c --icons)' \
    --bind 'ctrl-x:change-prompt(🔎  )+reload(ghq-list-projects)' \
    --bind 'ctrl-f:change-prompt(🔎  )+reload(ghq-list-projects)' \
    --bind 'ctrl-d:execute(tmux kill-session -t {2..})+change-prompt(⚡  )+reload(sesh list -t -c --icons; ghq-list-projects)' \
    --preview-window 'right:55%' \
    --preview 'sesh preview "$(printf "%s\\n" {} | sed -e "s|^${REPO_ICON} |${REPOS_ROOT}/|" -e "s|^[^ ]* ||")"'
)"

[ -n "$choice" ] || exit 0
choice=$(printf '%s\n' "$choice" | sed -e "s|^${REPO_ICON} |${REPOS_ROOT}/|" -e 's|^[^ ]* ||')
sesh connect "$choice"
