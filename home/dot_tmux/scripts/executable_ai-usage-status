#!/usr/bin/env bash

export PATH="$HOME/.local/share/mise/shims:$PATH"

json="$(timeout 30 ai-usagebar usage --json 2>/dev/null)" || {
  printf '#[fg=#cba6f7,bold]CX#[nobold] #[fg=#f38ba8]? #[fg=#585b70]│ #[fg=#cba6f7,bold]CC#[nobold] #[fg=#f38ba8]?'
  exit
}

jq -r '
  def color($severity):
    if $severity == "low" then "#a6e3a1"
    elif $severity == "mid" then "#f9e2af"
    elif $severity == "high" then "#fab387"
    else "#f38ba8"
    end;

  def entry($id): (.entries | map(select(.id == $id)) | .[0]);
  def metric($entry; $prefix):
    (($entry.metrics // []) | map(select(.label | startswith($prefix))) | .[0]);
  def name($label): "#[fg=#cba6f7,bold]\($label)#[nobold]";
  def unavailable($label): "\(name($label)) #[fg=#f38ba8]?";
  def paint($metric; $label): "#[fg=#7f849c]\($label) #[fg=\(color($metric.severity))]\($metric.value)";
  def pair($session; $weekly): paint($session; "S") + " " + paint($weekly; "W");

  def codex:
    entry("openai") as $entry
    | metric($entry; "Codex 5h") as $session
    | metric($entry; "Codex weekly") as $weekly
    | if $entry == null or $entry.status != "ready" or $entry.stale or $session == null or $weekly == null then
        unavailable("CX")
      else
        name("CX") + " " + pair($session; $weekly)
      end;

  def claude:
    entry("anthropic") as $entry
    | metric($entry; "Session") as $session
    | metric($entry; "Weekly") as $weekly
    | if $entry == null or $entry.status != "ready" or $entry.stale or $session == null or $weekly == null then
        unavailable("CC")
      else
        name("CC") + " " + pair($session; $weekly)
      end;

  codex + " #[fg=#585b70]│ " + claude
' <<<"$json" 2>/dev/null || printf '#[fg=#cba6f7,bold]CX#[nobold] #[fg=#f38ba8]? #[fg=#585b70]│ #[fg=#cba6f7,bold]CC#[nobold] #[fg=#f38ba8]?'
